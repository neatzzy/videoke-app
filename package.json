{
  "name": "videoke-app",
  "type": "module",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "electron:dev": "concurrently \"nuxt dev\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "nuxt generate && electron-builder"
  },
  "build": {
    "appId": "com.karaokelive.app",
    "productName": "KaraokeLive",
    "files": [
      "electron/**/*",
      ".output/**/*"
    ],
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@upstash/redis": "^1.38.0",
    "nuxt": "^4.4.8",
    "pusher": "^5.3.4",
    "pusher-js": "^8.5.0",
    "vercel": "^59.1.4",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.0.10"
  }
}
