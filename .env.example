# Copie para .env na raiz e preencha. Este arquivo é versionado; o .env não.
# Os valores são lidos no build como default de runtimeConfig. Em produção,
# prefira NUXT_<CHAVE> no ambiente de execução (ver README).

# YouTube Data API (busca de músicas) — privada
API_KEY=

# Upstash Redis (persistência da sessão) — privadas
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Pusher (realtime, lado servidor) — privadas
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=mt1

# Pusher (lado cliente, expostas ao browser)
NUXT_PUBLIC_PUSHER_KEY=
NUXT_PUBLIC_PUSHER_CLUSTER=mt1

# URL pública da sala (QR code do host). Opcional: sem ela usa a origem da página do host.
NUXT_PUBLIC_SITE_URL=
